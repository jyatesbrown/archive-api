{
  "name": "@archive-api/api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker exposing point-in-time queries (asof / diff / history) over an archive-harness store in D1 + R2.",
  "type": "module",
  "main": "./src/lib.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "fixture:load": "node --experimental-strip-types scripts/load-fixture.ts",
    "key:mint": "pnpm build && node --experimental-strip-types scripts/mint-key.ts"
  },
  "dependencies": {
    "@archive-api/engine": "workspace:*"
  },
  "devDependencies": {
    "@archive-api/fixture": "workspace:*",
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.7.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
